# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv*/
venv/
.env

# Large experiment outputs in src/
# (training/eval dumped checkpoints, logs, and tables next to the scripts;
#  keep them out of the repo — the curated copies live under artifacts/)
src/*.csv
src/*.json
src/*.jsonl
src/*.txt
src/*.png
src/*.pdf
src/*.pt
src/*.npz

# Large output / archive folders
src/plots*/
src/fr3_plots*/
src/fr3_ros_eval_runs*/
src/delete_later/
src_cleanup_archive*/
src/*archive*/
src/safe_candidates*/
src/fr3_hardpool_v6_final/

# Docker / dev-container reproduction outputs
out/
out_*/

# Generated datasets / scenarios / rollouts (huge and/or regenerable)
# NOTE / TRAP: this also ignores scenarios and zips placed under config/.
# If you regenerate scenarios, do NOT expect to commit them from config/ —
# the committed copies live under artifacts/scenarios/ instead (see below).
data/
rollouts/
config/generated_scenarios*/
config/*.zip
*.bag
*.db3

# Keep source code (un-ignore, in case a broad rule above would catch it)
!src/*.py
!src/*.cpp
!src/*.h
!src/*.hpp

# Reproducibility artifacts are ALWAYS tracked.
# Everything under artifacts/ must never be ignored, even if a broader rule
# above would otherwise match it (e.g. *.zip, *.csv, *.npz).
!artifacts/
!artifacts/**

# OS / editor
.DS_Store
.vscode/
.idea/
